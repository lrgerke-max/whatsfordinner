# Kitchen Memory — environment variables
#
# The app runs completely out of the box with ZERO configuration: every AI
# capability is backed by a deterministic mock provider (see
# src/ai/index.ts and docs/ai-architecture.md), so none of the variables
# below are required to build, run, or demo the app.
#
# They exist purely as the wiring point for a future real backend. Copy
# this file to .env and fill in values only once you've built a server-side
# adapter per docs/ai-architecture.md.

# --- AI provider selection -------------------------------------------------
# "mock" (default) uses the built-in deterministic providers.
# "real" is a CONVENTION for a future server-backed adapter you would
# implement in src/ai/providers/real/ — src/ai/index.ts does not read this
# variable yet; providers are swapped by editing that file (see its comments
# and docs/ai-architecture.md).
EXPO_PUBLIC_AI_PROVIDER=mock

# Base URL of YOUR OWN backend that proxies to a model provider. The mobile
# client must never hold a model API key directly (see the Security section
# of the README) — it calls this URL, and your server holds the real key.
EXPO_PUBLIC_API_BASE_URL=https://api.your-kitchen-memory-backend.example.com

# --- Server-side only (never prefixed with EXPO_PUBLIC_, never bundled into
#     the client) — set these on whatever backend you stand up, not here. ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# --- Future integrations (architected for, not required for the MVP) ------
# WALMART_API_CLIENT_ID=
# WALMART_API_CLIENT_SECRET=
# INSTACART_CONNECT_API_KEY=
